{
  "source": {
    "spec": "docs/architecture/governance/policy-truth-tables.md",
    "spec_revision": "governance 0.6 addendum 12 (implementation baseline B3, GD-37)",
    "status": "DRAFT matrices. Test-fixture values only. Not a policy release, not a configuration acceptance, not runtime validation.",
    "covers": "Section 2 (AP), 3 (TS), 4 (SU), 5 (AG) and 5.1 (CB) of the spec.",
    "not_covered": [
      "Section 6 (SC-03 scenarios): scenario and trace evidence, not policy unit cases.",
      "Section 7 (DC, Layer 2 decision precedence): needs thresholds and the decision engine (roadmap Weeks 7 and 8).",
      "Section 8.1 (CT, claim-time currentness): needs the runtime claim and the currentness comparison.",
      "Section 8.2 (Nour's OD04 cases): mapped in the spec to cases covered here, or not governance."
    ],
    "conventions": [
      "Every case is the baseline input with input_overrides merged on top. Dicts merge key by key, every other value, including null and lists, replaces.",
      "amount_relation, where present, states how the proposed amount relates to the test threshold. A test checks it against the real decimals.",
      "A case id with a suffix (AP-08.a) is a variant of the spec row AP-08. Variants marked derived_from come from the configuration's amount_input rules, not from the spec row text.",
      "expected.basis is asserted only where the spec states one."
    ]
  },
  "test_configuration": {
    "label": "TEST_FIXTURE",
    "note": "Clearly labelled test values. The threshold is deliberately not the draft policy-set value, so no test can pass by hard-coding that number. The shape follows procurement-policy-set-v0.1.yaml.",
    "policy_set": { "id": "test-fixture-policy-set", "version": "test" },
    "policies": {
      "PROC-APPROVAL-01": {
        "version": "test-approval-v1",
        "criticality": "critical",
        "applies_to_tools": ["create_purchase_order"],
        "comparator": "GT",
        "currency_rules": [
          { "currency": "USD", "threshold": "1000.00", "approval_level": "manager", "fraction_digits": 2 }
        ],
        "amount_input": {
          "representation": "DECIMAL_STRING",
          "pattern": "(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,2})?",
          "positive_only": true,
          "whitespace": "REJECT",
          "exponent": "REJECT",
          "excess_precision": "REJECT"
        },
        "currency_handling": { "match": "EXACT_CASE_SENSITIVE", "fx_conversion": "DISABLED" },
        "validity": {
          "time_expiry": "NONE",
          "must_match_current_binding": [
            "request_revision",
            "supplier_id",
            "total_amount",
            "currency",
            "approval_level",
            "calculation_ref",
            "policy_version"
          ],
          "ordering": "RECORD_SEQUENCE",
          "unorderable_or_future_dated": "UNRESOLVED"
        }
      },
      "PROC-TOOL-STAGE-01": {
        "version": "test-tool-stage-v1",
        "criticality": "critical",
        "applies_to_tools": "ALL",
        "match": "EXACT_CASE_SENSITIVE",
        "stage_allowlist": {
          "PRE_APPROVAL": ["search_policy", "get_supplier", "request_approval", "calculate_approval_level"],
          "APPROVED": ["create_purchase_order"],
          "PO_CREATION": [],
          "COMPLETED": []
        }
      },
      "PROC-SUPPLIER-01": {
        "version": "test-supplier-v1",
        "criticality": "critical",
        "applies_to_tools": ["create_purchase_order"],
        "eligible_status": "APPROVED"
      }
    }
  },
