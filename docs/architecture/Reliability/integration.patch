+# ==============================================================================
+# TrustOps AI — Declarative Failure Taxonomy & RCA Candidate Specification v1.0
+# Canonical Repository Path:
+#   packages/reliability-engine/src/trustops_reliability/taxonomy/failure_taxonomy.yaml
+# Owner: Ahmed Ragab (AI Reliability & Machine Learning Engineer)
+# Task / Epic: S1-03 — Freeze Failure Taxonomy & Evaluator Contracts (TAI-EP03)
+# Status: DRAFT — Awaiting Team Review
+# Authoritative Baseline: TrustOps AI Project Proposal v1.1 (Sections K, L, M, O, P, Q, R)
+# ==============================================================================
+
+schema_version: "1.0.0"
+taxonomy_version: "taxonomy_v1.0.0_draft"
+status: "DRAFT_AWAITING_TEAM_REVIEW"
+owner: "Ahmed Ragab (packages/reliability-engine)"
+last_updated: "2026-10-29"
+
+governance_rules:
+  single_primary_label_per_trace: true
+  allow_secondary_findings: true
+  secondary_findings_never_override_primary_label: true
+  evaluator_output_never_used_as_ground_truth: true
+  llm_judge_is_fallible_signal_only: true
+  allowed_evaluator_families:
+    - "deterministic"
+    - "rag"
+    - "semantic_llm"
+    - "security"
+    - "agent_workflow"
+    - "policy_conformance"
+  precedence_hierarchy:
+    - tier: 1
+      description: "Adversarial attack trigger overrides induced downstream symptoms."
+      classes:
+        - "PROMPT_INJECTION"
+    - tier: 2
+      description: "Upstream missing retrieval context overrides downstream ungrounded generation."
+      classes:
+        - "RETRIEVAL_FAILURE"
+    - tier: 3
+      description: "Agent tool selection, workflow stage-ordering bypass, or argument corruption overrides resulting policy or completion symptoms."
+      classes:
+        - "TOOL_SELECTION_ERROR"
+        - "WORKFLOW_VIOLATION"
+        - "INVALID_TOOL_ARGUMENTS"
+    - tier: 4
+      description: "Substantive business policy breach when workflow stage sequence was otherwise valid."
+      classes:
+        - "POLICY_VIOLATION"
+    - tier: 5
+      description: "Downstream semantic hallucination (when retrieval succeeded) or false action-completion claim (when no Tier 1-4 failure occurred first)."
+      classes:
+        - "UNSUPPORTED_COMPLETION"
+        - "HALLUCINATION"
+  same_tier_tie_breaker:
+    rule_id: "TB-SAME-TIER-V1"
+    description: >
+      Deterministic 4-step tie-breaker applied whenever two or more failure classes
+      within the same precedence tier (specifically Tier 3 or Tier 5) co-occur on the
+      same trace. Selects a single primary_label and places all remaining observed
+      classes into secondary_findings.
+    steps:
+      - step: 1
+        name: "Earliest Causal Event Sequence Number"
+        rule: "If the co-occurring same-tier failures originate on distinct trace events, select the failure class whose earliest supporting causal event has the lower sequence_number (earlier timestamp)."
+      - step: 2
+        name: "Structural & State-Machine Precondition Priority (Same Triggering Event)"
+        rule: "If two same-tier failure classes share the exact same triggering event, select the structural/state-machine precondition failure over the parameter-level or claim-level defect: in Tier 3, TOOL_SELECTION_ERROR > WORKFLOW_VIOLATION > INVALID_TOOL_ARGUMENTS; in Tier 5, UNSUPPORTED_COMPLETION > HALLUCINATION."
+      - step: 3
+        name: "Higher Evaluator Finding Severity"
+        rule: "If still tied on the same event, select the failure class with the higher evaluator finding severity (critical > high > medium > low)."
+      - step: 4
+        name: "Canonical Intra-Tier Array Order"
+        rule: "As a final deterministic fallback, select the class listed first in precedence_hierarchy.classes for that tier."
+    tier_3_co_occurrence_rule: >
+      When a single tool_proposal or tool_call simultaneously violates workflow stage
+      preconditions (e.g., proposing create_purchase_order in PRE_APPROVAL without manager
+      approval -> WORKFLOW_VIOLATION) AND supplies invalid or corrupted arguments (e.g.,
+      quantity <= 0 or cost mismatch -> INVALID_TOOL_ARGUMENTS), WORKFLOW_VIOLATION is
+      always assigned as primary_label and INVALID_TOOL_ARGUMENTS is recorded in
+      secondary_findings (because the tool was forbidden to be invoked in that state
+      regardless of its arguments). If INVALID_TOOL_ARGUMENTS occurred on an earlier
+      permitted tool call (e.g., e2) and WORKFLOW_VIOLATION occurred on a later tool
+      proposal (e.g., e6), Step 1 selects INVALID_TOOL_ARGUMENTS as primary_label and
+      records WORKFLOW_VIOLATION in secondary_findings.
+  strip_ground_truth_at_inference:
+    - "scenario_metadata.is_seeded_failure"
+    - "scenario_metadata.injection_recipe_id"
+    - "scenario_metadata.injected_failure_class"
+    - "scenario_metadata.injected_root_cause"
+    - "scenario_metadata.expected_critical_policy_result"
