{
  "name": "trustops-ai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.28.2",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": "11.28.2"
  },
  "scripts": {
    "dev": "pnpm --filter @trustops/dashboard dev",
    "build": "pnpm --filter @trustops/dashboard build",
    "start": "pnpm --filter @trustops/dashboard start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm --filter @trustops/dashboard typecheck && tsc --project tsconfig.tests.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "jsdom": "30.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
