# INACTIVE TEMPLATE: see docs/operations/workflow-activation.md.
# Move to .github/workflows/ with a .yml extension in the implementation PR.
name: API integration CI

on:
  pull_request:
    branches: [dev, main]
  push:
    branches: [dev, main]
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: ${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}

defaults:
  run:
    shell: bash

jobs:
  integration:
    name: API integration tests
    runs-on: ubuntu-24.04
    timeout-minutes: 20
    env:
      COMPOSE_PROJECT_NAME: trustops-integration-${{ github.run_id }}-${{ github.run_attempt }}
      # Disposable CI credentials only; compose.test.yml must use these values.
      POSTGRES_USER: trustops_test
      POSTGRES_PASSWORD: trustops_ci_only
      POSTGRES_DB: trustops_test
      DATABASE_URL: postgresql://trustops_test:trustops_ci_only@127.0.0.1:5432/trustops_test
    steps:
      - name: Check out repository
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - name: Require integration implementation
        run: |
          test -s compose.test.yml
          test -s scripts/ci/migrate-test-db.sh
          test -d tests/integration
          test -d tests/e2e/api

      - name: Set up uv
        uses: astral-sh/setup-uv@c18668ad3cf93ea998bef934396af7bb5c839dc7 # v10.2.0
        with:
          version: "0.13.0"
          enable-cache: true
          cache-dependency-glob: uv.lock

      - name: Install Python
        run: uv python install

      - name: Install locked workspace
        run: uv sync --locked --all-packages --all-groups --no-editable

      - name: Validate standalone test stack
        run: docker compose -f compose.test.yml config --quiet

      - name: Start isolated dependencies and wait for health checks
        run: docker compose -f compose.test.yml up --build --wait --wait-timeout 120

      - name: Apply production migrations to the test database
        run: bash scripts/ci/migrate-test-db.sh

      # Separate invocations ensure neither suite can be silently empty.
      - name: Run integration tests
        run: uv run --no-sync pytest tests/integration

      - name: Run API end-to-end tests
        run: uv run --no-sync pytest tests/e2e/api

      - name: Show dependency logs on failure
        if: failure()
        run: docker compose -f compose.test.yml logs --no-color

      - name: Remove this job's disposable stack
        if: always()
        run: docker compose -f compose.test.yml down --volumes --remove-orphans
