# INACTIVE TEMPLATE: see docs/operations/workflow-activation.md.
# Move to .github/workflows/ with a .yml extension in the implementation PR.
name: MLOps CLI CI

on:
  pull_request:
    branches: [dev, main]
  push:
    branches: [dev, main]
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: ${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}

defaults:
  run:
    shell: bash

jobs:
  cli:
    name: MLOps CLI smoke
    runs-on: ubuntu-24.04
    timeout-minutes: 10
    env:
      MLOPS_CLI: REPLACE_WITH_INSTALLED_CONSOLE_COMMAND
    steps:
      - name: Check out repository
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - name: Require the implemented console command name
        run: |
          if [[ "$MLOPS_CLI" == REPLACE_* || ! "$MLOPS_CLI" =~ ^[a-zA-Z0-9_-]+$ ]]; then
            echo "::error::Set MLOPS_CLI to the implemented console entry point."
            exit 1
          fi

      - name: Set up uv
        uses: astral-sh/setup-uv@c18668ad3cf93ea998bef934396af7bb5c839dc7 # v10.2.0
        with:
          version: "0.13.0"
          enable-cache: true
          cache-dependency-glob: uv.lock

      - name: Install Python
        run: uv python install

      - name: Install locked workspace
        run: uv sync --locked --all-packages --all-groups --no-editable

      - name: Exercise installed CLI outside the source directory
        working-directory: ${{ runner.temp }}
        run: |
          uv run --project "$GITHUB_WORKSPACE" --no-sync "$MLOPS_CLI" --help > "$RUNNER_TEMP/mlops-help.txt"
          test -s "$RUNNER_TEMP/mlops-help.txt"
          cat "$RUNNER_TEMP/mlops-help.txt"
